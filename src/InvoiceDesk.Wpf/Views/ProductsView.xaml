<UserControl x:Class="InvoiceDesk.Wpf.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:InvoiceDesk.Wpf.Localization"
             xmlns:vm="clr-namespace:InvoiceDesk.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ProductsViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource SearchBox}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="DescriptionBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="Height" Value="72" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <!-- One row of the price list: what is sold on the left, what it costs
             on the right -->
        <Style x:Key="ProductListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Margin="8,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="308" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- List -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,12,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,6">
                    <TextBox Style="{StaticResource SearchBox}"
                             Tag="{loc:Text Products_SearchPlaceholder}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,10,0,0">
                        <Button HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"
                                Command="{Binding NewProductCommand}"
                                Content="{loc:Text Products_New}" />
                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  IsChecked="{Binding ShowArchived}"
                                  Content="{loc:Text Products_ShowArchived}" />
                    </Grid>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0" Padding="14,8">
                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ListSummary}" />
                </Border>

                <ListBox ItemsSource="{Binding Products}"
                         SelectedItem="{Binding SelectedProduct}"
                         ItemContainerStyle="{StaticResource ProductListItem}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Name}" />
                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding Subtitle}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding PriceText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Editor -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource PageTitleText}" FontSize="16"
                               Text="{Binding EditorTitle}" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource SubtleButton}"
                            Command="{Binding ToggleArchiveCommand}"
                            Content="{Binding ArchiveActionText}" />
                </Grid>

                <!-- Actions and messages stay pinned under the form -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,4,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource DangerTextBrush}"
                                       Text="{Binding ValidationMessage}" />
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding StatusMessage}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                                    Command="{Binding CancelCommand}"
                                    Content="{loc:Text Products_Cancel}" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}"
                                    Content="{loc:Text Products_Save}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Products_Name}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Products_Unit}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Products_UnitPrice}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Products_TaxRate}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Products_Description}" />
                            <TextBox Style="{StaticResource DescriptionBox}"
                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
