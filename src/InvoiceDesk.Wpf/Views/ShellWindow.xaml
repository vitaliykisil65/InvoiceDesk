<Window x:Class="InvoiceDesk.Wpf.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:InvoiceDesk.Wpf.Localization"
        xmlns:vm="clr-namespace:InvoiceDesk.Wpf.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="InvoiceDesk"
        Height="720" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfacePageBrush}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}" Text="&#xE8A5;" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Text="InvoiceDesk" />
                        <TextBlock FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding CompanyName, StringFormat={}- {0}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimizeClick"
                                ToolTip="{loc:Text Shell_Minimize}" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                                Click="OnMaximizeRestoreClick" ToolTip="{loc:Text Shell_Maximize}" />
                        <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnCloseClick"
                                ToolTip="{loc:Text Shell_Close}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="184" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="0,1,0,0" Padding="14,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Text Shell_LocalDatabase}" />
                            </StackPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding Pages}"
                                 SelectedItem="{Binding SelectedPage}"
                                 ItemContainerStyle="{StaticResource NavigationItem}"
                                 Background="Transparent" BorderThickness="0" Margin="0,8"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Border>

                <!-- Page host -->
                <Grid Grid.Column="1" Background="{DynamicResource SurfacePageBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Style="{StaticResource SearchBox}" MaxWidth="420"
                                 HorizontalAlignment="Left" MinWidth="260"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{loc:Text Shell_SearchPlaceholder}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SubmitSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="10,0,8,0"
                                Command="{Binding NewInvoiceCommand}"
                                Content="{loc:Text Shell_NewInvoice}" />

                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                Command="{Binding ToggleThemeCommand}"
                                Content="{Binding ThemeGlyph}" ToolTip="{loc:Text Shell_SwitchTheme}" />
                    </Grid>

                    <!-- A page that failed to load says so here, once, for every page -->
                    <Border Grid.Row="1" Margin="20,12,20,0" CornerRadius="6" Padding="12,8"
                            Background="{DynamicResource DangerSoftBrush}"
                            Visibility="{Binding CurrentPage.LoadError, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerTextBrush}"
                                   Text="{Binding CurrentPage.LoadError}" />
                    </Border>

                    <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Margin="20,14,20,16" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
