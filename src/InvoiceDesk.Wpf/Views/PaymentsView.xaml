<UserControl x:Class="InvoiceDesk.Wpf.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:InvoiceDesk.Wpf.Localization"
             xmlns:vm="clr-namespace:InvoiceDesk.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:PaymentsViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style x:Key="PaymentListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource SearchBox}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- List -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
            <DockPanel>

                <Grid DockPanel.Dock="Top" Margin="14,14,14,10">
                    <TextBox Width="260" HorizontalAlignment="Left" Style="{StaticResource SearchBox}"
                             Tag="{loc:Text Payments_SearchPlaceholder}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource SubtleButton}"
                            Command="{Binding DeleteCommand}"
                            Content="{loc:Text Payments_Delete}" />
                </Grid>

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0" Padding="14,8">
                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ListSummary}" />
                </Border>

                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,1" Padding="14,7" Background="{DynamicResource SurfaceMutedBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}"
                                   Text="{loc:Text Payments_ColumnInvoice}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}"
                                   Text="{loc:Text Payments_ColumnClient}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}"
                                   Text="{loc:Text Payments_ColumnDate}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" TextAlignment="Right"
                                   Text="{loc:Text Payments_ColumnAmount}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Margin="16,0,0,0"
                                   Text="{loc:Text Payments_ColumnMethod}" />
                    </Grid>
                </Border>

                <Grid>
                    <ListBox ItemsSource="{Binding Payments}"
                             SelectedItem="{Binding SelectedPayment}"
                             ItemContainerStyle="{StaticResource PaymentListItem}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" FontSize="12" FontFamily="Consolas"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding InvoiceNumber}" />
                                    <TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding ClientName}" />
                                    <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding PaidOnText}" />
                                    <TextBlock Grid.Column="3" FontSize="13" VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding AmountText}" />
                                    <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center"
                                               Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding Method}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{loc:Text Payments_Empty}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Record a payment -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,16" Style="{StaticResource PageTitleText}"
                           FontSize="16" Text="{loc:Text Payments_NewTitle}" />

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerTextBrush}"
                                   Text="{Binding ValidationMessage}" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding StatusMessage}" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}"
                                Content="{loc:Text Payments_Save}" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Payments_Invoice}" />
                        <ComboBox Height="34" Margin="0,0,0,12" FontSize="13"
                                  ItemsSource="{Binding InvoiceOptions}"
                                  SelectedItem="{Binding SelectedInvoiceOption, Mode=TwoWay}"
                                  DisplayMemberPath="Label" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding DateHint}" />
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding PaidOn, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Payments_Amount}" />
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Payments_Method}" />
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding Method, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Payments_Reference}" />
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>