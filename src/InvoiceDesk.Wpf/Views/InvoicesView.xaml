<UserControl x:Class="InvoiceDesk.Wpf.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:InvoiceDesk.Wpf.Localization"
             xmlns:vm="clr-namespace:InvoiceDesk.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:InvoicesViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <!-- One invoice row; the whole row is the click target -->
        <Style x:Key="InvoiceListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Style="{StaticResource CardBorder}" Padding="0">
        <DockPanel>

            <!-- Filters -->
            <Grid DockPanel.Dock="Top" Margin="14,14,14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="220" Style="{StaticResource SearchBox}"
                             Tag="{loc:Text Invoices_SearchPlaceholder}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="150" Height="32" Margin="8,0,0,0" FontSize="13"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                    <ComboBox Width="180" Height="32" Margin="8,0,0,0" FontSize="13"
                              ItemsSource="{Binding ClientOptions}"
                              SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                            Command="{Binding OpenInvoiceCommand}"
                            Content="{loc:Text Invoices_Open}" />
                    <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                            Command="{Binding MarkAsSentCommand}"
                            Content="{loc:Text Invoices_MarkAsSent}" />
                    <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                            Command="{Binding RecordPaymentCommand}"
                            Content="{loc:Text Invoices_RecordPayment}" />
                    <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                            Command="{Binding DeleteDraftCommand}"
                            Content="{loc:Text Invoices_DeleteDraft}" />
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewInvoiceCommand}"
                            Content="{loc:Text Invoices_New}" />
                </StackPanel>
            </Grid>

            <!-- Summary and messages -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0" Padding="14,8">
                <Grid>
                    <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                               Text="{Binding ListSummary}" />
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding StatusMessage}" />
                </Grid>
            </Border>

            <!-- Column headers -->
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,1" Padding="14,7" Background="{DynamicResource SurfaceMutedBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}"
                               Text="{loc:Text Invoices_ColumnNumber}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}"
                               Text="{loc:Text Invoices_ColumnClient}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}"
                               Text="{loc:Text Invoices_ColumnIssued}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}"
                               Text="{loc:Text Invoices_ColumnDue}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" TextAlignment="Right"
                               Text="{loc:Text Invoices_ColumnTotal}" />
                    <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeader}" TextAlignment="Right"
                               Text="{loc:Text Invoices_ColumnOutstanding}" />
                    <TextBlock Grid.Column="6" Style="{StaticResource ColumnHeader}" Margin="16,0,0,0"
                               Text="{loc:Text Invoices_ColumnStatus}" />
                </Grid>
            </Border>

            <Grid>
                <ListBox ItemsSource="{Binding Invoices}"
                         SelectedItem="{Binding SelectedInvoice}"
                         ItemContainerStyle="{StaticResource InvoiceListItem}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- Double-clicking a row is the fastest way into the editor -->
                    <ListBox.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenInvoiceCommand}" />
                    </ListBox.InputBindings>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" FontSize="12" FontFamily="Consolas"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding Number}" />
                                <TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding ClientName}" />
                                <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding IssuedText}" />
                                <TextBlock Grid.Column="3" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding DueText}" />
                                <TextBlock Grid.Column="4" FontSize="13" VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding TotalText}" />
                                <TextBlock Grid.Column="5" FontSize="13" VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding OutstandingText}" />
                                <Border Grid.Column="6" Style="{StaticResource StatusPill}" Margin="16,0,0,0">
                                    <TextBlock Style="{StaticResource StatusPillText}"
                                               Text="{Binding StatusText}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Nothing matches, or there is nothing yet -->
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{loc:Text Invoices_Empty}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
