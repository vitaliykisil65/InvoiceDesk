<UserControl x:Class="InvoiceDesk.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:InvoiceDesk.Wpf.Localization"
             xmlns:services="clr-namespace:InvoiceDesk.Wpf.Services"
             xmlns:vm="clr-namespace:InvoiceDesk.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- One row of the settings form: label and hint on the left, control on the right -->
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,10" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
        </Style>

        <Style x:Key="PathBox" TargetType="TextBox" BasedOn="{StaticResource SearchBox}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>

        <!-- Theme option: a radio button that looks like a segmented control -->
        <Style x:Key="ThemeOption" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Theme" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="6" Padding="12,6"
                                Background="{DynamicResource SurfaceCardBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <ContentPresenter x:Name="Label" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Label" Property="TextElement.Foreground"
                                        Value="{DynamicResource AccentTextBrush}" />
                                <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

    </UserControl.Resources>

    <Border Style="{StaticResource CardBorder}" Padding="0">
        <DockPanel>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceMutedBrush}"
                    CornerRadius="0,0,8,8" Padding="18,10">
                <Grid>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionText}"
                               Text="{Binding StatusMessage}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                                Command="{Binding ResetDefaultsCommand}"
                                Content="{loc:Text Settings_ResetDefaults}" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}"
                                Content="{loc:Text Settings_Save}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
                <StackPanel>

                    <!-- Appearance -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Text Settings_Appearance}" />
                    <TextBlock Margin="0,2,0,12" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{loc:Text Settings_AppearanceHint}" />

                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Text Settings_Theme}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Text Settings_ThemeHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource ThemeOption}"
                                         Content="{loc:Text Theme_Light}"
                                         IsChecked="{Binding SelectedTheme, Mode=TwoWay,
                                             Converter={StaticResource EnumMatchConverter},
                                             ConverterParameter={x:Static services:ThemePreference.Light}}" />
                            <RadioButton Style="{StaticResource ThemeOption}"
                                         Content="{loc:Text Theme_Dark}"
                                         IsChecked="{Binding SelectedTheme, Mode=TwoWay,
                                             Converter={StaticResource EnumMatchConverter},
                                             ConverterParameter={x:Static services:ThemePreference.Dark}}" />
                            <RadioButton Style="{StaticResource ThemeOption}"
                                         Content="{loc:Text Theme_System}"
                                         IsChecked="{Binding SelectedTheme, Mode=TwoWay,
                                             Converter={StaticResource EnumMatchConverter},
                                             ConverterParameter={x:Static services:ThemePreference.System}}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Text Settings_Language}" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Text="{Binding LanguageHint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Height="30" FontSize="13"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="NativeName" />
                    </Grid>

                    <!-- Storage -->
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,22,0,0"
                               Text="{loc:Text Settings_Storage}" />
                    <TextBlock Margin="0,2,0,12" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{loc:Text Settings_StorageHint}" />

                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Text Settings_Reports}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ReportsFolderInfo}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource PathBox}" Margin="0,0,8,0"
                                 Text="{Binding ReportsFolder}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" Margin="0,0,6,0"
                                    ToolTip="{loc:Text Settings_Browse}"
                                    Command="{Binding BrowseFolderCommand}" CommandParameter="ReportsFolder" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8A7;"
                                    ToolTip="{loc:Text Settings_OpenFolder}"
                                    Command="{Binding OpenFolderCommand}" CommandParameter="ReportsFolder" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Text Settings_Backups}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Text Settings_BackupsHint}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource PathBox}" Margin="0,0,8,0"
                                 Text="{Binding BackupsFolder}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" Margin="0,0,6,0"
                                    ToolTip="{loc:Text Settings_Browse}"
                                    Command="{Binding BrowseFolderCommand}" CommandParameter="BackupsFolder" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8A7;"
                                    ToolTip="{loc:Text Settings_OpenFolder}"
                                    Command="{Binding OpenFolderCommand}" CommandParameter="BackupsFolder" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Text Settings_AfterExport}" />
                            <TextBlock Style="{StaticResource CaptionText}"
                                       Text="{loc:Text Settings_AfterExportHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <CheckBox FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                      IsChecked="{Binding AskWhereToSave}"
                                      Content="{loc:Text Settings_AskWhereToSave}" />
                            <CheckBox Margin="0,8,0,0" FontSize="13"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      IsChecked="{Binding OpenFolderAfterExport}"
                                      Content="{loc:Text Settings_OpenFolderAfterExport}" />
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
