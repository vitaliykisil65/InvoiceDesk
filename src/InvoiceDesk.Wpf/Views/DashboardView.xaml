<UserControl x:Class="InvoiceDesk.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:domain="clr-namespace:InvoiceDesk.Domain.Entities;assembly=InvoiceDesk.Domain"
             xmlns:loc="clr-namespace:InvoiceDesk.Wpf.Localization"
             xmlns:vm="clr-namespace:InvoiceDesk.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- Status pill: colour comes from the invoice state -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:InvoiceStatus.Sent}">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:InvoiceStatus.PartiallyPaid}">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:InvoiceStatus.Paid}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:InvoiceStatus.Overdue}">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:InvoiceStatus.Sent}">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:InvoiceStatus.PartiallyPaid}">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:InvoiceStatus.Paid}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:InvoiceStatus.Overdue}">
                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Metrics -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource MetricBorder}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding CurrentMonthLabel}" />
                    <TextBlock Style="{StaticResource MetricValueText}" Text="{Binding RevenueThisMonth}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricBorder}" Margin="6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Text Dashboard_Outstanding}" />
                    <TextBlock Style="{StaticResource MetricValueText}" Text="{Binding OutstandingTotal}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricBorder}" Margin="6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Text Dashboard_Overdue}" />
                    <TextBlock Style="{StaticResource MetricValueText}" Text="{Binding OverdueTotal}"
                               Foreground="{DynamicResource DangerTextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricBorder}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Text Dashboard_Clients}" />
                    <TextBlock Style="{StaticResource MetricValueText}" Text="{Binding ClientCount}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Revenue chart -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock FontSize="12" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextSecondaryBrush}" Text="{loc:Text Dashboard_RevenueByMonth}" />
                <ItemsControl ItemsSource="{Binding MonthlyRevenue}" Height="118">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"
                                        Height="{Binding BarHeight}"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        ToolTip="{Binding Amount, StringFormat={}{0:N0}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Row="1" Margin="0,6,0,0" HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionText}" Text="{Binding Label}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Recent invoices -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceMutedBrush}"
                        CornerRadius="8,8,0,0" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionText}" Text="{loc:Text Column_Number}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="{loc:Text Column_Client}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" Text="{loc:Text Column_Due}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource CaptionText}" Text="{loc:Text Column_Total}"
                                   TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Style="{StaticResource CaptionText}" Text="{loc:Text Column_Status}"
                                   Margin="16,0,0,0" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecentInvoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                                        Padding="14,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" FontSize="12" FontFamily="Consolas"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding Number}" />
                                        <TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding ClientName}" />
                                        <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding DueText}" />
                                        <TextBlock Grid.Column="3" FontSize="13" VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding TotalText}" />
                                        <Border Grid.Column="4" Style="{StaticResource StatusPill}" Margin="16,0,0,0">
                                            <TextBlock Style="{StaticResource StatusPillText}"
                                                       Text="{Binding StatusText}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" Margin="2,10,0,0" Style="{StaticResource CaptionText}"
                   Text="{Binding DataSummary}" />
    </Grid>
</UserControl>
