<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\InvoiceDesk.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Product>InvoiceDesk</Product>
    <AssemblyTitle>InvoiceDesk</AssemblyTitle>
    <Company>InvoiceDesk</Company>
    <Description>Invoicing for small businesses.</Description>
    <Copyright>Copyright © 2026 InvoiceDesk</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\InvoiceDesk.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InvoiceDesk.Data\InvoiceDesk.Data.csproj" />
    <ProjectReference Include="..\InvoiceDesk.Domain\InvoiceDesk.Domain.csproj" />
  </ItemGroup>

</Project>
