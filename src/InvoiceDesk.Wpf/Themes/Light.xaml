<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfacePageBrush" Color="#F4F4F1" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#EDEDE9" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E6E6E1" />

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E1E1DB" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CFCFC8" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B19" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#63635E" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E8E88" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Roles -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563A8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1E528C" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6F1FB" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#185FA5" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBEAEA" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#A32D2D" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EAF3DE" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#3B6D11" />

</ResourceDictionary>
