<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="InvoiceDesk"
           Manufacturer="InvoiceDesk"
           Version="$(ProductVersion)"
           UpgradeCode="5398F8F8-BD6F-4050-B99C-5407BB11D439"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <!-- Installing again upgrades in place instead of leaving two entries behind. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of InvoiceDesk is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="InvoiceDeskIcon" SourceFile="..\src\InvoiceDesk.Wpf\Assets\InvoiceDesk.ico" />
    <Property Id="ARPPRODUCTICON" Value="InvoiceDeskIcon" />

    <!--
      The database, the settings and the logs live in %AppData%\InvoiceDesk and
      are deliberately left alone: uninstalling the program must not throw away
      the user's invoices.
    -->
    <Feature Id="Main" Title="InvoiceDesk" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!--
      The stock install-directory wizard, with the license step taken out of the
      sequence: welcome, folder, install. Nothing is being licensed here, so a
      page asking the user to accept terms would be noise.
    -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="3" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3" />
    </UI>

  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="InvoiceDesk" />
    </StandardDirectory>

    <!--
      The published output is one self-contained executable plus the font files
      QuestPDF renders PDFs with.
    -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="9C2D7D8E-1B4A-4E3B-8F52-6F0D8B9A4C11">
        <Shortcut Id="InvoiceDeskShortcut"
                  Name="InvoiceDesk"
                  Description="Invoicing for small businesses."
                  Target="[INSTALLFOLDER]InvoiceDesk.Wpf.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="InvoiceDeskIcon" />
        <RegistryValue Root="HKCU" Key="Software\InvoiceDesk"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

</Wix>
